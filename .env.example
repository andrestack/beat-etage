# Keystatic GitHub mode. /keystatic/setup writes these into .env for you;
# copy the same four values into Vercel (Production and Preview).
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Optional. Storage defaults to `local` in `npm run dev` and `github` in builds.
# Set to github to try GitHub mode locally, or local to build without GitHub.
# PUBLIC_KEYSTATIC_STORAGE=github
