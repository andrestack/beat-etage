---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSingleton, switchLocale, type Locale } from '../lib/content';
import { t } from '../lib/i18n';

interface Props { locale: Locale; title: string; description?: string }
const { locale, title, description } = Astro.props;
const settings = await getSingleton('settings', locale);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const site = Astro.site?.origin ?? '';
const ui = t(locale);
---
<!doctype html>
<html lang={locale} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Beat-Etage" />
    <link rel="canonical" href={site + path} />
    <link rel="alternate" hreflang="de-de" href={site + switchLocale(path, 'de')} />
    <link rel="alternate" hreflang="en" href={site + switchLocale(path, 'en')} />
    <link rel="alternate" hreflang="x-default" href={site + switchLocale(path, 'de')} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>document.documentElement.className = 'js';</script>
  </head>
  <body>
    <a class="skip" href="#main">{ui.skip}</a>
    <Header settings={settings} locale={locale} />
    <main id="main"><slot /></main>
    <Footer settings={settings} locale={locale} />
    <script>
      // Peel an offer tile off the wall before following its link. Plain clicks only:
      // new-tab clicks and reduced motion go straight through.
      const calm = matchMedia('(prefers-reduced-motion: reduce)');
      document.addEventListener('click', (e) => {
        const tile = (e.target as Element).closest?.('a.tile') as HTMLAnchorElement | null;
        if (!tile || calm.matches || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || tile.target) return;
        e.preventDefault();
        tile.classList.add('is-peeling');
        setTimeout(() => { location.href = tile.href; }, 380);
      });
      // Coming back via the back button restores the page from cache: put the note back.
      addEventListener('pageshow', () => document.querySelectorAll('.is-peeling').forEach((el) => el.classList.remove('is-peeling')));
    </script>
    <script>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }),
          { rootMargin: '0px 0px -8% 0px' },
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
      } else {
        document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
