---
import { href, switchLocale, type Locale } from '../lib/content';
import { bookingHref, isExternal } from '../lib/booking';
import { t } from '../lib/i18n';
interface Props { settings: any; locale: Locale }
const { settings, locale } = Astro.props;
const ui = t(locale);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const other: Locale = locale === 'de' ? 'en' : 'de';
const here = (h: string) => { const target = href(locale, h); return path === target || path.startsWith(target + '/'); };
const book = settings.booking.url ? bookingHref(settings) : href(locale, settings.cta.href);
---
<header class="hdr">
  <a class="hdr__brand" href={href(locale, '/')} aria-label={`${settings.siteName}: ${ui.home}`}><span class="logo hdr__logo" aria-hidden="true"></span></a>
  <nav class="hdr__nav" aria-label="Hauptnavigation">
    {settings.nav.map((n: any) => n.items?.length ? (
      <div class="hdr__drop">
        <a href={href(locale, n.href)} aria-current={[n, ...n.items].some((x: any) => here(x.href)) ? 'page' : undefined}>{n.label}</a>
        <div class="hdr__sub">
          {n.items.map((s: any) => <a href={href(locale, s.href)} aria-current={here(s.href) ? 'page' : undefined}>{s.label}</a>)}
        </div>
      </div>
    ) : (
      <a href={href(locale, n.href)} aria-current={here(n.href) ? 'page' : undefined}>{n.label}</a>
    ))}
  </nav>
  <a class="hdr__lang" href={switchLocale(path, other)} hreflang={other} lang={other} aria-label={ui.langName}>
    <span class="hdr__lang-roll" aria-hidden="true"><span>{locale.toUpperCase()}</span><span>{other.toUpperCase()}</span></span>
  </a>
  <a class="btn" href={book} target={isExternal(book) && book.startsWith('http') ? '_blank' : undefined} rel={book.startsWith('http') ? 'noopener' : undefined}>{settings.cta.label}</a>
  <details class="hdr__menu">
    <summary>{ui.menu}</summary>
    <div class="hdr__sheet">
      {settings.nav.map((n: any) => n.items?.length
        ? [<a href={href(locale, n.href)}>{n.label}</a>, ...n.items.filter((s: any) => s.href !== n.href).map((s: any) => <a href={href(locale, s.href)}>{s.label}</a>)]
        : <a href={href(locale, n.href)}>{n.label}</a>)}
    </div>
  </details>
</header>
<script>
  // Mouse users already see the other language on hover, so they go straight there.
  // On touch there is no hover: roll the label first so the tap shows where it leads.
  const sw = document.querySelector<HTMLAnchorElement>('.hdr__lang');
  if (sw) {
    sw.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
      if (matchMedia('(hover: hover) and (pointer: fine)').matches) return;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      e.preventDefault();
      sw.classList.add('is-going');
      setTimeout(() => { location.href = sw.href; }, 220);
    });
    addEventListener('pageshow', () => sw.classList.remove('is-going'));
  }
</script>
