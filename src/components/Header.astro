---
import { href, switchLocale, type Locale } from '../lib/content';
import { bookingHref, isExternal } from '../lib/booking';
import { t } from '../lib/i18n';
interface Props { settings: any; locale: Locale }
const { settings, locale } = Astro.props;
const ui = t(locale);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const other: Locale = locale === 'de' ? 'en' : 'de';
const here = (h: string) => { const target = href(locale, h); return path === target || path.startsWith(target + '/'); };
const book = settings.booking.url ? bookingHref(settings) : href(locale, settings.cta.href);
---
<header class="hdr">
  <a class="hdr__brand" href={href(locale, '/')} aria-label={`${settings.siteName}: ${ui.home}`}>{settings.siteName}</a>
  <nav class="hdr__nav" aria-label="Hauptnavigation">
    {settings.nav.map((n: any) => (
      <a href={href(locale, n.href)} aria-current={here(n.href) ? 'page' : undefined}>{n.label}</a>
    ))}
  </nav>
  <a class="hdr__lang" href={switchLocale(path, other)} hreflang={other} lang={other} aria-label={ui.langName} data-lang={locale} data-from={locale} data-to={other}>
    <span class="hdr__lang-l hdr__lang-l--de" aria-hidden="true">DE</span>
    <span class="hdr__lang-t" aria-hidden="true"></span>
    <span class="hdr__lang-l hdr__lang-l--en" aria-hidden="true">EN</span>
  </a>
  <a class="btn" href={book} target={isExternal(book) && book.startsWith('http') ? '_blank' : undefined} rel={book.startsWith('http') ? 'noopener' : undefined}>{settings.cta.label}</a>
  <details class="hdr__menu">
    <summary>{ui.menu}</summary>
    <div class="hdr__sheet">
      {settings.nav.map((n: any) => <a href={href(locale, n.href)}>{n.label}</a>)}
    </div>
  </details>
</header>
<script>
  // Slide the switch to the other language, then navigate once it has moved.
  const sw = document.querySelector<HTMLAnchorElement>('.hdr__lang');
  if (sw) {
    sw.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      e.preventDefault();
      sw.dataset.lang = sw.dataset.to;
      setTimeout(() => { location.href = sw.href; }, 340);
    });
    // Coming back via the back button restores the page as it was left.
    addEventListener('pageshow', () => { sw.dataset.lang = sw.dataset.from; });
  }
</script>
