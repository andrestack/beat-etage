---
import Pic from './Pic.astro';
import FloorStrip from './FloorStrip.astro';
import { type Locale } from '../lib/content';
import { bookingHref } from '../lib/booking';
import { md } from '../lib/md';
import { t } from '../lib/i18n';
interface Props { data: any; settings: any; locale: Locale; floors: { slug: string; entry: any }[]; slug: string }
const { data, settings, locale, floors, slug } = Astro.props;
const ui = t(locale);
const cta = data.ctaHref?.trim() || bookingHref(settings, data.title);
const ext = cta.startsWith('http');

// Split "ab 24 € für 2 Personen" into a small lead-in, a big amount and the rest,
// so the ticket stub can show the number large. Text without an amount stays as is.
function splitPrice(p: string) {
  const m = p.match(/^(ab|from)?\s*(\d[\d.,]*\s*€|€\s*\d[\d.,]*)\s*(.*)$/i);
  return m ? { lead: m[1] ?? '', amount: m[2].replace(/\s+/g, '\u202f'), rest: m[3] } : { lead: '', amount: '', rest: p };
}
const onRequest = /anfrage|request|aufwand|effort/i;
function rowCta(c: any) {
  const request = !!data.ctaHref?.trim() || onRequest.test(c.price ?? '');
  const href = c.ctaHref?.trim() || data.ctaHref?.trim()
    || (request ? `mailto:${settings.email}?subject=${encodeURIComponent(c.name)}` : cta);
  return { href, label: c.ctaLabel?.trim() || (request ? ui.enquire : ui.book), ext: href.startsWith('http') };
}
---
<section class="fl">
  <div class="fl__copy">
    <h1 data-reveal>{data.title}</h1>
    <p class="fl__intro" data-reveal style="--d:140ms">{data.intro}</p>
    <a class="btn btn--dark" href={cta} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined} data-reveal style="--d:210ms">{data.ctaLabel}</a>
  </div>
  <div class="fl__pic" data-reveal style="--d:120ms">
    {data.label && <p class="fl__label">{data.label}</p>}
    <Pic src={data.image} alt={data.imageAlt} sizes="(min-width: 900px) 50vw, 100vw" loading="eager" widths={[600, 900, 1200, 1600]} />
  </div>
</section>

<section class="offers">
  <h2 data-reveal>{ui.classes}</h2>
  {data.prices?.length > 0 && (
    <ul class="prices" aria-label={ui.prices}>
      {data.prices.map((t: any, i: number) => (
        <li class:list={['price', { 'price--hi': t.featured }]} data-reveal style={`--d:${i * 60}ms`}>
          <p class="price__label">{t.label}</p>
          <p class="price__amount">{t.price}</p>
          {t.note && <p class="price__note">{t.note}</p>}
        </li>
      ))}
    </ul>
  )}
  {data.pricesNote?.trim() && <p class="prices__note" data-reveal>{data.pricesNote}</p>}
  <ul class="offers__list">
    {data.classes.map((c: any, i: number) => {
      const p = c.price ? splitPrice(c.price) : null;
      const b = rowCta(c);
      return (
        <li class="offer" data-reveal style={`--d:${i * 60}ms`}>
          <div class="offer__main">
            <h3>{c.name}</h3>
            {c.note && <p>{c.note}</p>}
          </div>
          <div class="offer__stub">
            <div class="offer__info">
            {p && (
              <p class="offer__price">
                <span class="offer__k">{ui.price}: </span>
                {p.lead && <span class="offer__lead">{p.lead}</span>}
                {p.amount ? <span class="offer__amount">{p.amount}</span> : <span class="offer__text">{p.rest}</span>}
                {p.amount && p.rest && <span class="offer__rest">{p.rest}</span>}
              </p>
            )}
            {c.when && <p class="offer__when"><span class="offer__wk">{data.whenLabel?.trim() || ui.when}</span>{c.when}</p>}
            </div>
            <a class="offer__btn" href={b.href} target={b.ext ? '_blank' : undefined} rel={b.ext ? 'noopener' : undefined}>
              {b.label}<span aria-hidden="true">{'\u00a0→'}</span><span class="offer__k">: {c.name}</span>
            </a>
          </div>
        </li>
      );
    })}
    {data.voucher?.title && (
      <li class="offer offer--voucher" data-reveal>
        <div class="offer__main"><h3>{data.voucher.title}</h3>{data.voucher.text && <p>{data.voucher.text}</p>}</div>
        {data.voucher.price && <p class="offer__price--list">{data.voucher.price}</p>}
      </li>
    )}
  </ul>
</section>

{data.body?.trim() && (
  <section class="more">
    <div class="prose prose--cols" set:html={md(data.body)} />
  </section>
)}

<FloorStrip floors={floors} locale={locale} title={ui.allFloors} exclude={slug} />

<section class="cta">
  <h2 data-reveal>{data.ctaTitle?.trim() || ui.ctaTitle}</h2>
  <p data-reveal style="--d:70ms">{data.ctaText?.trim() || ui.ctaText}</p>
  <a class="btn btn--dark" href={cta} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined} data-reveal style="--d:140ms">{data.ctaLabel}</a>
</section>
