---
import Pic from './Pic.astro';
import FloorStrip from './FloorStrip.astro';
import { md } from '../lib/md';
import { t } from '../lib/i18n';
import type { Locale } from '../lib/content';
interface Props { data: any; settings: any; locale: Locale; floors: { slug: string; entry: any }[] }
const { data, settings, locale, floors } = Astro.props;
const ui = t(locale);
const tel = settings.phone.replace(/[^\d+]/g, '').replace(/^0/, '+49');
---
<section class="page-head">
  <h1 data-reveal>{data.title}</h1>
  <p data-reveal style="--d:90ms">{data.intro}</p>
</section>
<section class="contact">
  <div class="contact__col">
    <div class="prose" data-reveal set:html={md(data.directions)} />
    <address class="card card--plain" data-reveal style="--d:90ms">
      <a href={`mailto:${settings.email}`}>{settings.email}</a>
      <a href={`tel:${tel}`}>{settings.phone}</a>
      <a class="btn btn--dark" href={`mailto:${settings.email}`}>{ui.mailUs}</a>
    </address>
  </div>
  <figure class="contact__pic" data-reveal style="--d:120ms">
    <Pic src={data.image} alt={data.imageAlt} sizes="(min-width: 900px) 50vw, 100vw" />
    <figcaption>{data.imageCaption}</figcaption>
  </figure>
</section>
<section class="room">
  <h2 data-reveal>{data.roomTitle}</h2>
  <div class="prose" data-reveal style="--d:90ms" set:html={md(data.roomText)} />
</section>
<FloorStrip floors={floors} locale={locale} title={ui.allFloors} />
